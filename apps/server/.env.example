PORT=3000
DATABASE_URL=postgres://card_forge:change-me@localhost:5432/card_forge
# Integration tests only. The database name must end with _test.
TEST_DATABASE_URL=postgres://card_forge:change-me@localhost:5432/card_forge_test
SESSION_PEPPER=replace-with-at-least-32-random-characters
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_GAME_VERIFY_URL=https://apps-in-toss-api.toss.im/api-partner/v1/apps-in-toss/users/anon-key/verify
TOSS_MTLS_CERT_PATH=/run/secrets/toss-client.crt
TOSS_MTLS_KEY_PATH=/run/secrets/toss-client.key
# TOSS_MTLS_CA_PATH=/run/secrets/toss-ca.crt
TOSS_REQUEST_TIMEOUT_MS=5000
TOSS_REQUEST_MAX_RETRIES=1
SESSION_TTL_SECONDS=3600
