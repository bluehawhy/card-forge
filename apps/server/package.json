{
  "name": "@card-forge/server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node dist/database/migrate.js",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:component": "jest --config jest.component.config.js --runInBand",
    "test:mtls": "jest --config jest.integration.config.js --runInBand --testPathPattern=toss-mtls",
    "test:postgres": "jest --config jest.integration.config.js --runInBand --testPathPattern=postgres",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:all": "npm test && npm run test:component && npm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
